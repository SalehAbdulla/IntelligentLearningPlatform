# StudyForge backend — required secrets
# ────────────────────────────────────────────────────────────────────────────
# Copy this file to `.env` (which is gitignored) for local emulator work, or set
# the values as Cloud Function secrets for a deploy:
#
#   firebase functions:secrets:set TAP_SECRET_KEY
#
# NEVER commit real values, and never ship any of these inside the iOS app.
# The app receives only a random public key and a charge reference.

# Tap Payments secret key — SERVER-SIDE ONLY. Sandbox values begin `sk_test_`.
TAP_SECRET_KEY=sk_test_replace_me

# Shared secret used to verify that a webhook really came from Tap.
# Without this, anyone could POST a fake "payment succeeded" and upgrade for free.
TAP_WEBHOOK_SECRET=whsec_replace_me

# Tap public key. NOT a secret — it ships in the app to configure the card SDK.
# Listed here only so the pair is obvious and nobody "protects" the wrong one.
TAP_PUBLIC_KEY=pk_test_replace_me

# Where Tap posts async status updates: the deployed `tapWebhook` function URL.
TAP_WEBHOOK_URL=https://us-central1-studyforge-it8108.cloudfunctions.net/tapWebhook

# Where Tap sends the student back after the hosted payment page.
TAP_REDIRECT_URL=https://studyforge.app/payment/return

# Optional merchant id (TAP_MERCHANT_ID); Tap uses it to attribute the charge.
TAP_MERCHANT_ID=

# Firebase project id, for convenience when scripting.
GCLOUD_PROJECT=studyforge-it8108
