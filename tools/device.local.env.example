# Per-machine settings for `bash tools/run-device.sh`.
#
# Copy this file to tools/device.local.env and fill in your own values.
# tools/device.local.env is gitignored, so your bundle id and team stay
# on your machine and never land in the shared project.

# The bundle identifier the app is signed and installed as. It must be one
# your Apple ID is allowed to provision. A personal team can only provision
# identifiers it has registered, so pick something unique to you. Note that
# this is NOT the identifier in the Xcode project (com.studyforge.app);
# overriding it is the whole point, because it keeps the repo on develop.
DEVICE_BUNDLE_ID="com.yourname.studyforge"

# Your 10-character Apple Developer team identifier.
# Xcode > Settings > Accounts > (select your team) - or read it off the
# "Apple Development: you@example.com (XXXXXXXXXX)" certificate.
DEVICE_TEAM="XXXXXXXXXX"
