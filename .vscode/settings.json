{
  "sweetpad.build.xcodeWorkspacePath": "ios/StudyForge/StudyForge.xcodeproj",
  "sweetpad.build.scheme": "StudyForge",
  "sweetpad.build.configuration": "Debug",
  "sweetpad.testing.configuration": "Debug",
  "files.exclude": {
    "**/.build": true,
    "**/DerivedData": true
  },
  "[swift]": {
    "editor.defaultFormatter": "swiftlang.swift-vscode",
    "editor.tabSize": 4,
    "editor.insertSpaces": true,
    "editor.formatOnSave": false
  }
}
