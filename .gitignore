# ── Secrets and environment (NEVER commit these) ────────────────────────────
GoogleService-Info.plist
**/GoogleService-Info.plist
*.xcconfig.local
Config/*.local.xcconfig
.env
.env.*
!.env.example
functions/.env
serviceAccountKey.json
**/serviceAccountKey.json

# Per-machine physical-device build settings for tools/run-device.sh
# (bundle identifier + Apple team id). Copy the .example file to set it up.
tools/device.local.env

# Firebase Admin SDK private keys. The console downloads these as
# "<projectId>-firebase-adminsdk-<hash>.json", which the pattern above does NOT
# match — so without this line, following Firebase's own instructions to
# "Generate new private key" produces a committable private key that grants full
# admin on the project.
**/*firebase-adminsdk*.json

# ── Xcode ───────────────────────────────────────────────────────────────────
build/
DerivedData/
*.xcuserstate
*.xcuserdatad/
xcuserdata/
*.moved-aside
*.hmap
*.ipa
*.dSYM.zip
*.dSYM
*.xccheckout
*.xcscmblueprint
*.pbxuser
!default.pbxuser
*.mode1v3
!default.mode1v3

# ── Swift Package Manager / CocoaPods ──────────────────────────────────────
.build/
.swiftpm/
Packages/
Pods/
*.xcworkspace/xcshareddata/swiftpm/configuration/registries.json

# ── Agent skills (installed artefacts, NOT source) ─────────────────────────
# The installed skill bodies (~3.3 MB) are regenerable from skills-lock.json,
# exactly like node_modules from package-lock.json. Commit the lockfile and the
# installer; let each machine run `bash tools/install-skills.sh`.
.agents/
.claude/
!.claude/settings.json

# ── Node / Firebase tooling ────────────────────────────────────────────────
node_modules/
firebase-debug.log
firebase-debug.*.log
ui-debug.log
*.log
.firebase/
.firebase/emulator-data/

# Cloud Functions build output (TypeScript -> lib/)
backend/functions/lib/
functions/lib/

# Firebase emulator export/import artefacts
firebase-export-*/

# Rules-test reports
backend/rules-tests/.coverage/

# ── Deliverables: the graded artefacts ARE tracked ─────────────────────────
# Reversed on 24 Oct 2026. This block used to read "keep the source, not the
# exports", leaving the .fig, the PDF, the bundle and the zip out of git on the
# grounds that they go through the portal. The cost of that: M2-M5 could not see
# the submission from a clone, and reproducing it needs Node plus a Chromium, so
# all four travel with the repository now.
# Stated plainly: every committed PDF is another ~25 MB blob in history and every
# zip another ~43 MB, so commit them at milestones, not on every rebuild -
# `bash tools/build-pdf.sh` regenerates both from the tracked Markdown.
# Still ignored: the Figma "export" scratch directory.
deliverables/**/export/
!deliverables/prototype/figma-link.txt
!deliverables/design-document/README.md
!deliverables/prototype/README.md

# ── Research: keep notes, drop bulky raw media ─────────────────────────────
research/**/*.mp4
research/**/*.mov
research/**/*.m4a
research/**/*.zip

# ── macOS ───────────────────────────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# ── Editors ─────────────────────────────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/tasks.json
.idea/
*.swp
*~
