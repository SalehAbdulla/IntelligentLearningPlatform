node_modules/
firebase-debug.log
firebase-debug.*.log
ui-debug.log
*.log
.firebase/
.firebase/emulator-data/

# Cloud Functions build output (TypeScript -> lib/)
backend/functions/lib/
functions/lib/

# Firebase emulator export/import artefacts
firebase-export-*/

# Rules-test reports
backend/rules-tests/.coverage/

# ── Deliverables: the zip is tracked, the loose artefacts are not ──────────
# Decided 24 Oct 2026. The submission zip carries every graded artefact inside
# it - the PDF, the .fig, the bundle and the 154 mockup figures - so ONE tracked
# ~43 MB file gives M2-M5 the entire submission from a clone, while the loose
# copies stay out of history: the PDF alone would be ~25 MB per version and the
# .fig ~1.8 MB, and both are already inside that zip.
# So `deliverables/StudyForge-Submission.zip` IS committed. The PDF, the .fig and
# the bundle remain reproducible (`bash tools/build-pdf.sh` from the tracked
# Markdown and figures) and are extracted from the zip when needed:
#   unzip deliverables/StudyForge-Submission.zip 01-Design-Document/StudyForge-Design-Document.pdf
deliverables/**/*.fig
deliverables/**/*.pdf
deliverables/**/export/
deliverables/submission/
!deliverables/prototype/figma-link.txt
!deliverables/design-document/README.md
!deliverables/prototype/README.md

# ── Research: keep notes, drop bulky raw media ─────────────────────────────
research/**/*.mp4
research/**/*.mov
research/**/*.m4a
research/**/*.zip

